# Leave this empty to use the offline mock provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# mock, ollama, or openai. The UI can switch per question.
LLM_PROVIDER=mock

# Ollama is not started by Compose. Point this at a server if you have one.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
